<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: warm-paper solid background + mascot foreground
     with built-in 25% padding, so launchers (ColorOS included) mask it cleanly
     instead of shrinking a square PNG onto a white plate. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_stat_meng"/>
</adaptive-icon>
