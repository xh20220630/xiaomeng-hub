{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小梦 Host",
  "version": "../../version.json",
  "identifier": "com.xiaomeng.host",
  "build": {
    "beforeDevCommand": { "script": "npm run prepare:host", "wait": true },
    "beforeBuildCommand": "npm run prepare:host",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["launcher"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": { "resources/": "runtime/" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
